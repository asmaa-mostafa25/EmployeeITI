@model List<EmployeeDep.ViewModels.DepartmentWithEmpCount>

@{
    ViewData["Title"] = "Departments";
    var recent = ViewBag.RecentDepartments as List<string> ?? new List<string>();
    string? lastVisited = ViewBag.LastVisitedDepartment as string;
}

<h1>Departments</h1>

<a asp-controller="Department"
   asp-action="AddDepartment"
   class="btn btn-primary">
    Add Department
</a>

<br />
<br />

@if (recent.Any())
{
    <div class="alert alert-secondary">
        <strong>Recently visited departments:</strong> @string.Join(", ", recent)
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Department Name</th>
            <th>Manager Name</th>
            <th>Number of Employees</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var department in Model)
        {
            <tr class="@(department.Name == lastVisited ? "table-warning" : "")">
                <td>@department.Id</td>
                <td>@department.Name</td>
                <td>@department.ManagerName</td>
                <td>@department.EmpCount</td>

                <td>
                    <a asp-controller="Department"
                       asp-action="GetDepById"
                       asp-route-id="@department.Id"
                       class="btn btn-outline-secondary">
                        Details
                    </a>

                    <a asp-controller="Department"
                       asp-action="EditDepartment"
                       asp-route-id="@department.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <form asp-controller="Department"
                          asp-action="DeleteDepartment"
                          asp-route-id="@department.Id"
                          method="post"
                          style="display:inline;"
                          onsubmit="return confirm('Delete this department?');">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                    </form>

                    <a asp-controller="Department"
                       asp-action="ShowEmployees"
                       asp-route-id="@department.Id"
                       class="btn btn-info">
                        Show Employees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
